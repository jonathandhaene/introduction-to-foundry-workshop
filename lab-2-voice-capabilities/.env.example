# All configuration from Lab 1
# Plus voice-specific settings

# Azure Speech Service Configuration
AZURE_SPEECH_KEY=your-speech-service-key
AZURE_SPEECH_REGION=eastus

# Voice Configuration
STT_LANGUAGE=en-US
TTS_VOICE_NAME=en-US-JennyNeural
TTS_VOICE_STYLE=friendly
AUDIO_FORMAT=riff-24khz-16bit-mono-pcm

# Voice features
ENABLE_VAD=true
VAD_THRESHOLD=30
SILENCE_DURATION=1.5

# GPT Realtime Configuration (for Sub-Lab 2.2 voice integration)
# Options: alloy, ash, ballad, coral, echo, sage, shimmer, verse
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime
AZURE_OPENAI_REALTIME_VOICE=shimmer
