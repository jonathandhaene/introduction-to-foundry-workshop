# GPT Realtime Configuration (for Lab 2 voice capabilities)
# All other configuration comes from lab-1-rag-chatbot/.env

# GPT Realtime model deployment (deployed in Sub-Lab 2.1)
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime

# Voice to use for GPT Realtime responses
